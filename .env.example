# Modèle des variables d'environnement. Copier en .env.local et remplir.
# N'y mettre AUCUNE vraie valeur : ce fichier est versionné.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM=

# OpenAI (assistant du site)
OPENAI_API_KEY=

# Higgsfield — serveur uniquement (voir README, section Higgsfield)
# Forme : KEY_ID:KEY_SECRET
HF_CREDENTIALS=
# Tout sauf exactement « false » garde le dry-run : aucune requête envoyée.
HIGGSFIELD_DRY_RUN=true
# Endpoints (identifiants de modèle) autorisés, séparés par des virgules.
# Vide : aucun. Ex. : /higgsfield-ai/soul/v2/standard,/bytedance/seedance-2.0/text-to-video
HIGGSFIELD_ALLOWED_ENDPOINTS=
# Plafonds sur le coût ESTIMÉ, en dollars. Obligatoires hors dry-run.
HIGGSFIELD_MAX_COST_USD_PER_REQUEST=
HIGGSFIELD_DAILY_BUDGET_USD=
